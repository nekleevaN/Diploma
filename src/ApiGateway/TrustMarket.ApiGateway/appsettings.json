{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-profile-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/ads/{**catch-all}"
        }
      },
      "chat-route": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/api/chats/{**catch-all}"
        }
      },
      "chat-hub-route": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "viewings-route": {
        "ClusterId": "chat-cluster",
        "Match": { "Path": "/api/viewings/{**catch-all}" }
      },
      "upload-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/upload/{**catch-all}"
        }
      },
      "uploads-static-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        }
      },
      "offers-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/offers/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "webhook-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/api/webhooks/{**catch-all}"
        }
      },
      "delivery-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/api/delivery/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/api/orders"
        }
      },
      "orders-sub-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users-api": {
            "Address": "http://user-service:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://catalog-service:8080/"
          }
        }
      },
      "chat-cluster": {
        "Destinations": {
          "chat-api": {
            "Address": "http://chat-service:8080/"
          }
        }
      },
      "finance-cluster": {
        "Destinations": {
          "finance-api": {
            "Address": "http://finance-service:8080/"
          }
        }
      },
      "review-cluster": {
        "Destinations": {
          "review-api": {
            "Address": "http://review-service:8080/"
          }
        }
      }
    }
  }
}
